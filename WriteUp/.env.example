# ── WriteUp backend environment variables ─────────────────────
# Copy this file to .env and fill in the values.
# Never commit your real .env file.

# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Supabase project credentials (https://app.supabase.com/)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to "true" to bypass Supabase and run with in-memory mock sessions.
# Useful for local development without a database.
MOCK_SUPABASE=true

# Port the Express server listens on.
PORT=3000

# Allowed CORS origin for the frontend (optional).
# Defaults to the production Vercel URL and http://localhost:5173.
CLIENT_URL=http://localhost:5173
